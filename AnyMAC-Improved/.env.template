# ============================================================
# MedRoute Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# === vLLM (recommended backend — OpenAI-compatible API) ===
# Specialist model endpoint (vLLM auto-launched by the train_*.sh / run_baseline_*.sh scripts)
BASE_URL=http://localhost:8000

# Judge model endpoint (separate vLLM instance for reward / answer judging)
JUDGE_BASE_URL=http://localhost:8001

# API key (vLLM accepts "EMPTY"; set a real key for OpenAI / Azure)
API_KEY=EMPTY

# === Azure OpenAI (optional alternative backend) ===
# ENDPOINT_URL=https://your-endpoint.openai.azure.com/
# DEPLOYMENT_NAME=gpt-4.1-mini
# AZURE_OPENAI_API_KEY=your-key-here
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
